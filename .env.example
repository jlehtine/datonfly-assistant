# Environment variable naming convention
#
# All Datonfly configuration uses a single suite-wide DF_ prefix. The only
# exceptions are the two API keys read directly by their vendor SDKs:
# ANTHROPIC_API_KEY and OPENAI_API_KEY (no prefix), plus the permanent
# unprefixed fallbacks for PORT and DATABASE_URL.
#
# Unprefixed legacy names are no longer read. See ENV_MIGRATION.md for the full
# mapping, including the DF_ANTHROPIC_* -> DF_AGENT_* rename.

# Anthropic API credentials (canonical name, read by the SDK — no DF_ prefix)
#
# Commented out by default: this file ships pointed at the fixture playback
# harness below instead, so a fresh checkout works out of the box with no key
# and no billing. Set this (and comment out the two lines below it) for real
# development or for running the E2E suite against the live API.
#ANTHROPIC_API_KEY=sk-ant-...

# Fixture playback harness (E2E testing) — active by default
#
# ANTHROPIC_BASE_URL is read by the Anthropic SDK itself — there is no DF_
# variable and no application wiring for it. Pointing it at the local playback
# harness (started automatically by `pnpm dev`, see `agent-anthropic`'s
# `fake-api` script) makes every agent call replay a recorded/synthesised
# fixture instead of reaching the real API: deterministic, free, and fast.
#
# The SDK still requires a non-empty key even when the endpoint is fake, hence
# the dummy value below.
#
# To develop or test against the real Anthropic API instead — required for
# genuine live E2E runs, and for anything beyond the fixed set of recorded
# scenarios — comment out BOTH lines below and set a real `ANTHROPIC_API_KEY`
# above. Never leave a real key set while `ANTHROPIC_BASE_URL` points somewhere
# other than Anthropic's own API.
#
# Note: replayed responses are roughly 6x faster than the real API, so a test
# suite run back-to-back would exceed the default 20/minute `message` rate-limit
# tier — every E2E test authenticates as the same fake user, so they share one
# bucket. DF_RATE_LIMIT_FACTOR below is raised accordingly.
ANTHROPIC_BASE_URL=http://localhost:4010
ANTHROPIC_API_KEY=sk-ant-test

# Agent model to use
#
# For quick testing and development, use a smaller/cheaper model like
# claude-haiku-4-5 and disable all server-side tools.
DF_AGENT_MODEL=claude-opus-5
#DF_AGENT_MODEL=claude-sonnet-5
#DF_AGENT_MODEL=claude-haiku-4-5

# Model for auto-generating thread titles. Titling is always on: comment this
# out and titles are generated with DF_AGENT_MODEL instead. Point it at a
# cheaper model to keep titling off the main model's bill.
DF_AGENT_TITLE_MODEL=claude-haiku-4-5

# Optional: audio input transcription via OpenAI (omit OPENAI_API_KEY to disable)
# OPENAI_API_KEY is a canonical name read by the SDK — no DF_ prefix.
# OPENAI_API_KEY=sk-...
# DF_OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Extended thinking / reasoning
#
# Reasoning defaults to adaptive with a summarized display: the model decides
# when to think, and returns a summary of what it thought. Thinking tokens are
# billed as output, so set DF_ANTHROPIC_THINKING_TYPE=disabled to stop paying
# for them.
#
# Note that "summarized" has to be requested explicitly — the Anthropic default
# reasons and bills the tokens but returns no reasoning text at all. That is why
# this provider always sends a display mode.
#
# DF_ANTHROPIC_THINKING_TYPE — reasoning mode:
#   "adaptive"  Anthropic decides when to think based on prompt complexity (default)
#   "disabled"  No reasoning, and no thinking tokens billed
# DF_ANTHROPIC_THINKING_TYPE=adaptive
#
# DF_ANTHROPIC_THINKING_DISPLAY — controls how reasoning blocks appear in the response:
#   "summarized"  The model returns a concise summary of its reasoning (default)
#   "omitted"     Reasoning is performed and billed, but not returned
# DF_ANTHROPIC_THINKING_DISPLAY=summarized
#
# Short or easy questions produce no summary even when one is requested: there
# has to be enough reasoning to be worth summarising.
#
# DF_ANTHROPIC_THINKING_EFFORT — output effort level when DF_ANTHROPIC_THINKING_TYPE=adaptive:
#   "low"    Fastest, least thorough
#   "medium" Balanced (recommended starting point)
#   "high"   More thorough, slower
#   "xhigh"  Very thorough
#   "max"    Maximum reasoning; highest latency and cost
# DF_ANTHROPIC_THINKING_EFFORT=medium

# Server-side tools (Anthropic-specific) — set to "false" to disable (all enabled by default)
# DF_ANTHROPIC_ENABLE_COMPACTION=true
# DF_ANTHROPIC_ENABLE_CODE_EXECUTION=true
# DF_ANTHROPIC_ENABLE_WEB_SEARCH=true
# DF_ANTHROPIC_ENABLE_WEB_FETCH=true

# Custom tools via MCP (Model Context Protocol) — disabled by default.
#
# DF_MCP_SERVERS — JSON array of external MCP servers whose tools are exposed to
# the agent on every request. When unset, no custom tools are added and
# behaviour is unchanged. Each entry is either:
#   - a stdio server: { "name", "command", "args"?, "env"?, "cwd"? }
#   - a Streamable HTTP server: { "transport": "http", "name", "url", "headers"? }
# Tool names must be unique across all configured servers.
# Examples (single-line JSON; mind shell quoting):
# DF_MCP_SERVERS=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}]
# DF_MCP_SERVERS=[{"transport":"http","name":"remote","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer TOKEN"}}]
#
# DF_MCP_TOOL_TIMEOUT_MS — per tool-call timeout in milliseconds (defaults to the
# MCP SDK default when omitted).
# DF_MCP_TOOL_TIMEOUT_MS=30000

# Maximum number of model turns in a tool-calling loop before aborting (default: 10).
# Applies to both MCP and any other caller-provided tools.
# DF_AGENT_MAX_TOOL_ITERATIONS=10

# Authentication mode: "fake" (no login, for dev/test) or "oidc" (real OIDC provider)
DF_AUTH_MODE=fake

# Only required when DF_AUTH_MODE=oidc
# DF_OIDC_ISSUER_URL=https://accounts.google.com
# DF_OIDC_CLIENT_ID=your-client-id
# DF_OIDC_CLIENT_SECRET=your-client-secret
# DF_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional: restrict authenticated users to a specific email domain
# DF_OIDC_ALLOWED_EMAIL_DOMAIN=example.com

# Optional: comma-separated list of allowed email addresses.
# If set, only these addresses can authenticate. Other restrictions (e.g. domain) still apply.
# DF_OIDC_ALLOWED_EMAILS=alice@example.com,bob@example.com

# JWT secret (auto-generated if not set; set explicitly for persistent sessions)
# DF_JWT_SECRET=your-secret-here

# Session idle timeout in seconds (default: 604800 = 7 days).
# Both the JWT expiry and cookie maxAge are set to this value.
# The session is automatically extended on each authenticated /auth/me request.
# DF_SESSION_TTL_SECONDS=604800

# Fake user configuration (only when DF_AUTH_MODE=fake)
# DF_FAKE_USER_EMAIL=dev@localhost
# DF_FAKE_USER_NAME=Dev User

# PostgreSQL connection (enables persistence for users, threads, messages)
# The unprefixed DATABASE_URL is also accepted as a permanent fallback for
# platforms that inject it.
DF_DATABASE_URL=postgresql://datonfly:datonfly@localhost:5432/datonfly

# HTTP port (default: 3000). The unprefixed PORT is also accepted as a permanent
# fallback for platforms that inject it.
# DF_PORT=3000

# Frontend origin used for CORS and OIDC redirects (default: http://localhost:5173)
# DF_FRONTEND_URL=http://localhost:5173

# Log output format: "json" for machine-parseable JSON lines, or "pretty" (default) for human-readable output
# DF_LOG_FORMAT=json

# Log level: "trace", "debug", "info" (default), "warn", "error", "fatal"
# DF_LOG_LEVEL=info

# Trusted reverse proxy setting (forwarded to Express "trust proxy").
# Configure this when behind ingress/reverse proxies so server-side IP checks
# use forwarded client IPs.
# Supported formats:
#   - IP/CIDR list: "10.0.0.0/8,192.168.0.0/16"
#   - hop count: "1"
#   - booleans: "true" or "false"
# DF_TRUSTED_REVERSE_PROXY=10.0.0.0/8

# Member invite search strategy:
#   "default"              — any registered user can be discovered by partial name/email match
#   "limited-visibility"   — search only returns users who share a thread with the searcher;
#                            users not found via search can still be invited by exact email
# DF_MEMBER_SEARCH_STRATEGY=default

# Semantic thread search (requires Qdrant + infinity-emb from docker-compose.yml)
# Set DF_QDRANT_URL to enable; omit to disable search entirely.
DF_QDRANT_URL=http://localhost:6333
DF_INFINITY_URL=http://localhost:8080

# Embeddings request timeout in milliseconds. Defaults to 120000 (2 minutes).
# DF_EMBEDDINGS_TIMEOUT_MS=120000

# Snowball stemmer language for full-text keyword matching.
# Supported: arabic, danish, dutch, english, finnish, french, german, greek, hungarian,
#            italian, norwegian, portuguese, romanian, russian, spanish, swedish, tamil, turkish.
# Omit (recommended for multi-language deployments) to disable stemming — the multilingual
# tokenizer alone gives better cross-language recall than a wrong-language stemmer.
# Only set this for single-language deployments where all content is in one known language.
# DF_SEARCH_STEMMER_LANGUAGE=english

# Half-life for search recency decay, in days (default: 360).
# A message this many days old scores at half the weight of a message from today.
# Increase for longer-lived content, decrease to prefer only very recent threads.
# DF_SEARCH_RECENCY_HALF_LIFE_DAYS=360

# Admin endpoints (POST /datonfly-assistant/admin/reindex)
# Both DF_ADMIN_SECRET and DF_ADMIN_IPS must be set for admin access to be available.
# DF_ADMIN_SECRET — shared Bearer token for admin requests.
# DF_ADMIN_IPS — whitespace or comma-delimited list of allowed IP addresses or CIDR ranges.
# DF_ADMIN_SECRET=change-me-to-a-random-secret
# DF_ADMIN_IPS=127.0.0.1 ::1

# Rate limiting
#
# Per-subject request limits protect login, mutations, and expensive LLM-backed
# operations against brute-force and abuse. Limits are keyed by authenticated
# user id where available, falling back to the client IP (resolved through
# DF_TRUSTED_REVERSE_PROXY). Defaults are sized for tens of simultaneous users
# and work out of the box — most deployments need to set nothing here.
#
# Per-tier defaults (requests per minute, before DF_RATE_LIMIT_FACTOR):
#   read        300   authenticated GETs (thread list/detail, messages, members)
#   mutation     60   thread/message create/patch/delete, profile updates
#   auth         10   login / OIDC callback / logout (brute-force surface)
#   message      20   WebSocket send-message (triggers an agent run)
#   transcribe   10   POST /transcribe (audio transcription)
#   search       30   thread/user semantic search (embeddings)
#   upload       30   POST /attachments
#   admin         5   POST /admin/reindex (defense in depth)
#
# DF_RATE_LIMIT_ENABLED — "true" (default) / "false". Set "false" to disable all
# rate limiting (trusted networks, load testing, or host-managed limiting).
# DF_RATE_LIMIT_ENABLED=true
#
# DF_RATE_LIMIT_FACTOR — the single tuning knob: a positive multiplier (default
# 1.0) applied to every tier's limit. 2 doubles all allowances, 0.5 halves them.
#
# Raised to 10 here (message: 20 -> 200/min) for local development and E2E
# testing. Every E2E test authenticates as the same fake user, so the whole
# suite shares one bucket, and against the fixture playback harness responses
# come back ~6x faster than the real API — back-to-back runs otherwise exceed
# the default 20/min and fail with no assistant reply. The suite issues roughly
# 40 agent-invoking sends in total, so 200/min leaves a wide margin while still
# exercising the limiter rather than switching it off. Production deployments
# should leave this at the default.
DF_RATE_LIMIT_FACTOR=10
#
# DF_RATE_LIMIT_EXPECTED_USERS — optional positive integer. When set, enables an
# aggregate ceiling on the shared expensive pool (agent messages + transcription)
# sized at expectedUsers × per-user-expensive-allowance, bounding total load on
# the LLM/transcription provider. Omit for per-user limits only (no global cap).
# DF_RATE_LIMIT_EXPECTED_USERS=50
